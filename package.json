{
  "name": "coding-asmr",
  "version": "1.0.0",
  "description": "Handmade sound effects for Claude Code - typing clicks, scanner hums, and completion chimes",
  "main": "core/index.js",
  "scripts": {
    "on": "node cli.js on",
    "off": "node cli.js off",
    "volume": "node cli.js volume",
    "status": "node cli.js status",
    "install-hooks": "node cli.js install",
    "uninstall": "node cli.js uninstall",
    "stop": "node cli.js stop",
    "setup": "node setup.js",
    "test-sound": "node scripts/test-sound.js",
    "test-all": "node scripts/test-all.js"
  },
  "keywords": ["claude-code", "sound", "audio", "hooks", "plugin"],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
